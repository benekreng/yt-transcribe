# Copy to ~/.config/yt-transcribe/.env for one-time setup, or ./.env for a project.
# Replace the placeholder with your own key. Keep real .env files out of Git.
OPENAI_API_KEY=your-api-key

# Optional OpenAI-compatible endpoint and output location:
# OPENAI_BASE_URL=https://your-provider.example/v1
# REMEM_TRANSCRIPTS_DIR=~/transcripts
